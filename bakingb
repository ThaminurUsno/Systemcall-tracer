### 6. Syscall Implementations (`kernel/sysproc.c`)

**File:** `kernel/sysproc.c`

**trace() - Enable tracing for current process:**
```c
uint64
sys_trace(void)
{
  int mask;
  argint(0, &mask);  // Get mask argument from user
  myproc()->trace_mask = mask;
  return 0;
}

// Example: trace(0x7FFFFFFF) enables all syscalls
// 0x7FFFFFFF = 0111 1111 1111 1111 1111 1111 1111 1111
//              Sets bits 0-30, tracing syscalls 1-30
```

**strace() - Enable tracing for specific process:**
```c
uint64
sys_strace(void)
{
  int pid;
  argint(0, &pid);
  return trace_pid(pid);  // Call helper function
}

// Helper function in proc.c:
int
trace_pid(int pid)
{
  struct proc *p;
  for(p = proc; p < &proc[NPROC]; p++) {
    acquire(&p->lock);
    if(p->pid == pid) {
      p->trace_mask = 0x7FFFFFFF;  // Enable all syscalls
      release(&p->lock);
      return 0;
    }
    release(&p->lock);
  }
  return -1;  // Process not found
}
```

**trace_timing() - Enable/disable timing for current process:**
```c
uint64
sys_trace_timing(void)
{
  int flag;
  argint(0, &flag);  // Get flag: 0=disable, 1=enable
  myproc()->trace_timing = flag;
  return 0;
}

// Example: trace_timing(1) enables timing display
```

**strace_timing() - Enable/disable timing for specific process:**
```c
uint64
sys_strace_timing(void)
{
  int pid, flag;
  argint(0, &pid);
  argint(1, &flag);
  return trace_timing_pid(pid, flag);  // Call helper
}

// Helper function in proc.c:
int
trace_timing_pid(int pid, int flag)
{
  struct proc *p;
  for(p = proc; p < &proc[NPROC]; p++) {
    acquire(&p->lock);
    if(p->pid == pid) {
      p->trace_timing = flag;
      release(&p->lock);
      return 0;
    }
    release(&p->lock);
  }
  return -1;
}
```

